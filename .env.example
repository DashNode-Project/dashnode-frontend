# DashNode frontend - environment template.
# Copy to `.env` (git-ignored) and adjust. Everything prefixed with VITE_ is embedded in the
# public JavaScript bundle: NEVER put secrets in VITE_ variables.

# --- Browser-visible settings (build time) -------------------------------------------------
# Base path of the backend API as seen by the browser. Keep it relative (same origin) so the
# HttpOnly session cookie works through the dev proxy and the nginx container.
VITE_API_BASE_URL=/api/v1

# Public URL of this frontend. The backend uses its own FRONTEND_BASE_URL to build the links of
# the password-recovery e-mails (a future story); keep both values identical.
VITE_APP_PUBLIC_URL=http://localhost:5173

# --- Development server (vite dev / vite preview) -----------------------------------------
# Where the dev server proxies /api. Use 127.0.0.1 instead of localhost on Windows.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Container (docker compose) -----------------------------------------------------------
# Host port where the nginx container is published (bound to 127.0.0.1 only).
FRONTEND_HOST_PORT=8080
# API host:port reachable from the nginx container (docker network `dashnode-net`).
API_UPSTREAM=dashnode-api:8000
# Docker network shared with the backend compose project.
DASHNODE_NETWORK=dashnode-net
